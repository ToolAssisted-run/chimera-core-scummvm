{
  "coreName": "ScummVM",
  "systemId": "ScummVM",
  "systemNames": {
    "ScummVM": "ScummVM"
  },
  "author": "The ScummVM Team; chimera core by Sergio Martin",
  "url": "https://github.com/scummvm/scummvm",
  "runsOn": [ "windows-x86_64", "linux-x86_64", "macos-x86_64" ],
  "romFile": "game",
  "extensions": {
    ".zip": "ScummVM"
  },
  "_comment_extensions": "A ScummVM game is a folder of files, given as a zip of the folder. ScummVM's own detector finds the game in it.",
  "deterministic": true,
  "memoryLayoutMiB": [
    512,
    16,
    16,
    64,
    3072
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. ScummVM's engines load what they need of the game into memory (musl gives large allocations to mmap); the zip itself is read where Chimera mounted it. ScummVM's own stack (16 MiB) is mmap'd.",
  "video": {
    "_comment": "The game's screen at its own resolution (320x200 to the largest an engine draws), or ScummVM's menus over it. Capacity here is the largest allowed; GetVideoWidth/Height give the live size and GetDisplayAspectX/Y the shape (4:3 for games of 200 or 400 lines).",
    "width": 2560,
    "height": 1600,
    "getBgra": "GetVideoBgra",
    "vsyncNumerator": 60,
    "vsyncDenominator": 1
  },
  "audio": {
    "_comment": "ScummVM's mixer, run for exactly one frame's share of a second each frame: 735 stereo samples at 44100 Hz.",
    "sampleRate": 44100,
    "channels": 2,
    "samplesPerFrame": 735,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "settings": [
    {
      "name": "musicDriver",
      "display": "setting.musicdriver",
      "type": "enum",
      "options": [
        "auto",
        "adlib",
        "pcspk",
        "pcjr",
        "cms",
        "mt32",
        "cm32l",
        "null"
      ],
      "optionLabels": {
        "auto": "setting.musicdriver.auto",
        "adlib": "setting.musicdriver.adlib",
        "pcspk": "setting.musicdriver.pcspk",
        "pcjr": "setting.musicdriver.pcjr",
        "cms": "setting.musicdriver.cms",
        "mt32": "setting.musicdriver.mt32",
        "cm32l": "setting.musicdriver.cm32l",
        "null": "setting.musicdriver.null"
      },
      "default": "auto",
      "description": "setting.musicdriver.about"
    },
    {
      "name": "oplEmulator",
      "display": "setting.oplemulator",
      "type": "enum",
      "options": [
        "auto",
        "mame",
        "db",
        "nuked"
      ],
      "optionLabels": {
        "auto": "setting.oplemulator.auto",
        "mame": "setting.oplemulator.mame",
        "db": "setting.oplemulator.db",
        "nuked": "setting.oplemulator.nuked"
      },
      "default": "auto",
      "description": "setting.oplemulator.about"
    },
    {
      "name": "subtitles",
      "display": "setting.subtitles",
      "type": "bool",
      "default": true,
      "description": "setting.subtitles.about"
    },
    {
      "name": "renderer",
      "display": "setting.renderer",
      "type": "enum",
      "options": [
        "software",
        "opengl",
        "opengl_shaders"
      ],
      "optionLabels": {
        "software": "setting.renderer.software",
        "opengl": "setting.renderer.opengl",
        "opengl_shaders": "setting.renderer.opengl_shaders"
      },
      "default": "software",
      "description": "setting.renderer.about"
    }
  ],
  "firmware": [
    {
      "id": "MT32_CONTROL.ROM",
      "display": "firmware.mt32_control",
      "description": "firmware.mt32_control.about",
      "size": 65536,
      "name": "MT32_CONTROL.ROM",
      "label": "firmware.mt32_control.label",
      "requiredWhen": {
        "setting": "musicDriver",
        "is": "mt32"
      },
      "sha1": "B083518FFFB7F66B03C23B7EB4F868E62DC5A987"
    },
    {
      "id": "MT32_PCM.ROM",
      "display": "firmware.mt32_pcm",
      "description": "firmware.mt32_pcm.about",
      "size": 524288,
      "name": "MT32_PCM.ROM",
      "label": "firmware.mt32_pcm.label",
      "requiredWhen": {
        "setting": "musicDriver",
        "is": "mt32"
      },
      "sha1": "F6B1EEBC4B2D200EC6D3D21D51325D5B48C60252"
    },
    {
      "id": "CM32L_CONTROL.ROM",
      "display": "firmware.cm32l_control",
      "description": "firmware.cm32l_control.about",
      "size": 65536,
      "name": "CM32L_CONTROL.ROM",
      "label": "firmware.cm32l_control.label",
      "requiredWhen": {
        "setting": "musicDriver",
        "is": "cm32l"
      },
      "sha1": "A439FBB390DA38CADA95A7CBB1D6CA199CD66EF8"
    },
    {
      "id": "CM32L_PCM.ROM",
      "display": "firmware.cm32l_pcm",
      "description": "firmware.cm32l_pcm.about",
      "size": 1048576,
      "name": "CM32L_PCM.ROM",
      "label": "firmware.cm32l_pcm.label",
      "requiredWhen": {
        "setting": "musicDriver",
        "is": "cm32l"
      },
      "sha1": "289CC298AD532B702461BFC738009D9EBE8025EA"
    }
  ],
