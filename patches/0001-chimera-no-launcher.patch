+#ifdef CHIMERA_BACKEND
+// A Chimera machine plays the one game its project gives: there is no
+// launcher, and a game that cannot run ends the machine with ScummVM's
+// reason instead of showing an error box. Neither returns.
+void chimera_launcher_reached();
+void chimera_game_error(const char *desc);
+#endif
+
 static bool launcherDialog() {
+#ifdef CHIMERA_BACKEND
+	chimera_launcher_reached();
+#endif
 
